generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanTier {
  id                       String  @id @default(cuid())
  name                     String
  includedGateways         Int     @default(1)
  includedSensors          Int
  maxSensors               Int?
  extraSensorStripePriceId String?

  // --- BACKEND LIMITS (Strict Logic) ---
  maxUsers            Int? // Limit team members (e.g., 3 or null for unlimited)
  dataRetentionMonths Int  @default(6) // e.g., 6, 12, 84

  // --- UI MATRIX (Flexible Rendering) ---
  uiFeatureMatrix Json? // Stores the categorized feature list for the UI table

  priceAmount     Int          @default(0)
  currency        String       @default("eur")
  marketingDesc   String?
  isPopular       Boolean      @default(false)
  orderIndex      Int          @default(0)
  stripeProductId String       @unique @default(cuid())
  departments     Department[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  nif         String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id                   String             @id @default(uuid())
  slug                 String             @unique
  name                 String
  auth0OrgId           String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  planId               String?
  subStatus            SubscriptionStatus @default(ACTIVE)
  organizationId       String
  billingAddressId     String
  shippingAddressId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  billingAddress       Address            @relation("BillingAddress", fields: [billingAddressId], references: [id])
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 PlanTier?          @relation(fields: [planId], references: [id])
  shippingAddress      Address?           @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  labProfile           LabProfile? // Null means they haven't picked yet
  devices              Device[]
  orders               Order[]
  users                User[]
  projects             Project[]
  alerts               Alert[]
  logs                 SystemLog[]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  image        String?     
  auth0UserId  String?     @unique
  role         Role        @default(VIEWER)
  jobTitle     String?
  phone        String?
  departmentId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  orders       Order[]
  logs         SystemLog[]

  createdProjects    Project[]       @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  calibrations       CalibrationRecord[]
}

model Address {
  id                  String       @id @default(cuid())
  street              String
  city                String
  zipCode             String
  country             String
  nif                 String?
  contactName         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  billingDepartments  Department[] @relation("BillingAddress")
  shippingDepartments Department[] @relation("ShippingAddress")
}

model HardwareProduct {
  id              String       @id @default(cuid())
  sku             String       @unique
  name            String
  subtitle        String
  description     String?
  imageUrl        String?
  stripeProductId String?      @unique
  type            HardwareType
  stockQuantity   Int          @default(0)
  price           Decimal      @db.Decimal(10, 2)
  isFeatured      Boolean      @default(false) // <-- ADD THIS LINE
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  devices         Device[]
  orderItems      OrderItem[]
}

model Device {
  id           String              @id @default(cuid())
  name         String?
  serialNumber String              @unique
  status       DeviceStatus        @default(ACTIVE)
  productId    String
  departmentId String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  product      HardwareProduct     @relation(fields: [productId], references: [id])
  readings     SensorReading[]
  config       Json?               @default("{}")
  experiments  Experiment[]
  calibrations CalibrationRecord[]
  alerts       Alert[]
  logs         SystemLog[]
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Calibration Fields
  calibrationConfig Json?
  lastCalibrated    DateTime?
  calibrationDueDate DateTime?
}

model Order {
  id             String      @id @default(cuid())
  status         OrderStatus @default(PENDING_PAYMENT)
  departmentId   String
  customerEmail  String?
  customerName   String?
  userId         String?
  stripeIntentId String?     @unique
  trackingNumber String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  department     Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  items          OrderItem[]
}

model OrderItem {
  id        String          @id @default(cuid())
  quantity  Int
  orderId   String
  productId String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   HardwareProduct @relation(fields: [productId], references: [id])
}

model SensorReading {
  id           String      @id @default(cuid())
  deviceId     String
  metricType   String
  value        Float
  timestamp    DateTime    @default(now())
  device       Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  experimentId String?
  experiment   Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  // Update your index to make experiment data retrieval fast
  @@index([deviceId, timestamp(sort: Desc)])
  @@index([experimentId, timestamp(sort: Desc)]) // NEW INDEX
}

model CalibrationRecord {
  id             String   @id @default(cuid())
  deviceId       String
  userId         String?
  timestamp      DateTime @default(now())
  calibratedAt   DateTime @default(now())
  validUntil     DateTime?
  performedBy    String // e.g., "Fábrica", "Operador X"
  notes          String?
  pointsApplied  Json?
  oldConfig      Json?
  newConfig      Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId, calibratedAt(sort: Desc)])
}

model Alert {
  id           String        @id @default(cuid())
  departmentId String
  deviceId     String?
  experimentId String? // <-- ADDED: Link directly to the experiment
  severity     AlertSeverity
  title        String
  message      String?
  isRead       Boolean       @default(false)
  createdAt    DateTime      @default(now())

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  experiment Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([departmentId, createdAt(sort: Desc)])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_UNSHIPPED
  SHIPPED
  CANCELED
}

enum Role {
  ADMIN
  OPERATOR
  SUPER_ADMIN
  VIEWER
}

enum HardwareType {
  GATEWAY
  SENSOR_BASE
  SENSOR_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum DeviceStatus {
  UNCLAIMED
  ACTIVE
  MAINTENANCE
  PENDING_CONNECTION
  DISABLED
}

enum LabProfile {
  CONTINUOUS
  PROJECTS
}

model PendingCart {
  id        String   @id @default(cuid())
  items     Json // Store the raw cart items array here
  createdAt DateTime @default(now())
}

// --- NEW ENUMS ---
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  PAUSED
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  departmentId String
  createdById  String
  status       ProjectStatus @default(ACTIVE)

  // NEW: Project-level default configurations (e.g., default alert thresholds)
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  department  Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  experiments Experiment[]
  members     ProjectMember[]

  // NEW: Devices allocated to this project's equipment pool
  devices Device[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ensure a user can only have one explicit role per project
  @@unique([projectId, userId])
  @@index([userId])
}

model Experiment {
  id                 String           @id @default(cuid())
  name               String
  projectId          String
  status             ExperimentStatus @default(RUNNING)
  startDate          DateTime         @default(now())
  endDate            DateTime?
  settings           Json?
  accumulatedSeconds Int              @default(0)
  lastRunAt          DateTime?
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices            Device[]
  alerts             Alert[]
  readings           SensorReading[]
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum LogCategory {
  EXPERIMENT
  ALERT
  HARDWARE
  SYSTEM
}

model SystemLog {
  id            String      @id @default(uuid())
  timestamp     DateTime    @default(now())
  
  level         LogLevel
  category      LogCategory
  action        String      // e.g., "EXPERIMENT_STARTED", "THRESHOLD_EXCEEDED"
  message       String      // Human-readable description
  metadata      Json?       // Flexible payload for specific details (e.g., { "temperature": 45, "limit": 40 })

  // Tenant Isolation
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Relational Links (All Optional so a log can belong to any level)
  projectId     String?
  experimentId  String?
  deviceId      String?
  device        Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId        String?     // The Auth0 user who triggered the event, if applicable
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([projectId])
  @@index([experimentId])
  @@index([deviceId])
  @@index([timestamp])
}
